{
  "name": "couchroot",
  "private": true,
  "scripts": {
    "dev": "node preview/server.cjs",
    "test": "node --test tests/*.test.cjs tests/autonomous-root/*.test.cjs",
    "check:web-es5": "node scripts/check-web-es5.cjs",
    "test:ui": "node --test tests/ui.test.cjs tests/preview.test.cjs",
    "screenshots": "node preview/screenshots.cjs",
    "package": "python3 scripts/package.py",
    "deploy:ui": "python3 bin/deploy-ui",
    "format:check": "prettier --check \"agent/service/**/*.js\""
  },
  "devDependencies": {
    "acorn": "8.19.0",
    "playwright": "1.64.1",
    "prettier": "3.9.10"
  },
  "engines": {
    "node": ">=22"
  },
  "prettier": {
    "singleQuote": true,
    "quoteProps": "preserve",
    "trailingComma": "es5"
  }
}
